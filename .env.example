# 部署配置模板：复制为 .env 后填写（.env 已被 git 忽略，不会提交）
# cp .env.example .env

# 服务器地址（IP 或域名）—— 必须是公网服务器（本项目部署目标：www.xcherry.top）。
# ⚠️ 脚本内置安全校验，会拦截本机/局域网地址（127.x / 10.x / 172.16-31.x / 192.168.x / 169.254.x）：
#    本地 10.2.3.6:80 是独立项目的专门页面，与本项目无关，禁止作为部署目标。
DEPLOY_HOST=

# SSH 用户名
DEPLOY_USER=

# SSH 端口（默认 22）
DEPLOY_PORT=22

# SSH 密码（可选）
# - 留空：使用本机 SSH 密钥 / ssh-agent 认证（推荐，需先配置免密登录）
# - 填写：使用 sshpass 密码登录，本机需安装 sshpass
DEPLOY_PASSWORD=

# 部署目录（rsync 目标，建议以 / 结尾；--delete 会清除目标目录中本地已不存在的文件）
DEPLOY_REMOTE_DIR=/var/www/chery
