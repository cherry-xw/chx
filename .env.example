# 服务端口与前端基准地址
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# SQLite 数据库文件路径（相对 workspace/backend 或绝对路径）
SQLITE_PATH=./data/chery.db

# 双 Token 密钥与有效期
ACCESS_TOKEN_SECRET=replace-with-strong-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-strong-refresh-token-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Pocket ID OIDC 配置（支持与本地密码同时使用）
POCKET_ID_ISSUER=https://id.example.com
POCKET_ID_CLIENT_ID=your-pocket-id-client-id
POCKET_ID_CLIENT_SECRET=your-pocket-id-client-secret
POCKET_ID_REDIRECT_URI=http://localhost:4000/api/auth/pocket-id/callback
POCKET_ID_SCOPES=openid profile email

# 远程部署配置（SSH + rsync 推送 dist/，仅本地执行 deploy 时使用）
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22
DEPLOY_PASSWORD=
DEPLOY_REMOTE_DIR=/var/www/chery-backend/
