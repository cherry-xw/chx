    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "animate.css": "^4.1.1",
    "chery-fetch": "^1.0.13",
    "crypto-js": "^4.2.0",
    "element-plus": "^2.14.7",
    "idb": "^8.0.4",
