{
  "name": "chx",
  "version": "1.0.0",
  "private": true,
  "description": "chx monorepo: frontend(Vue3) + backend(Node/Express), workspace 子项目由独立 git 分支管理",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev:frontend": "pnpm --filter ./workspace/frontend run dev",
    "dev:backend": "pnpm --filter ./workspace/backend run serve",
    "build:frontend": "pnpm --filter ./workspace/frontend run build",
    "type-check:frontend": "pnpm --filter ./workspace/frontend run type-check",
    "test:frontend": "pnpm --filter ./workspace/frontend run test:entrance",
    "lint:frontend": "pnpm --filter ./workspace/frontend run lint",
    "format:frontend": "pnpm --filter ./workspace/frontend run format",
    "preview:frontend": "pnpm --filter ./workspace/frontend run preview",
    "deploy:frontend": "pnpm --filter ./workspace/frontend run deploy",
    "deploy:backend": "pnpm --filter ./workspace/backend run dispose"
  }
}
