{
  "name": "chx",
  "version": "1.0.0",
  "private": true,
  "description": "chx monorepo: frontend(Vue3) + backend(Node/Express), workspace 子项目由独立 git 分支管理",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm --filter ./workspace/frontend dev",
    "build": "pnpm --filter ./workspace/frontend build",
    "test": "pnpm --filter ./workspace/frontend test",
    "dev:backend": "pnpm --filter ./workspace/backend serve"
  }
}
